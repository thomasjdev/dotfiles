# Follow macOS light/dark appearance
theme = light:Catppuccin Latte,dark:Catppuccin Macchiato
font-family = "JetBrainsMono Nerd Font Mono"
font-style = Regular
font-size = 13

# Window
window-theme = auto
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true
window-width = 175
window-height = 45
window-save-state = always
confirm-close-surface=false
resize-overlay = never

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
#notify-on-command-finish-after = 30s
bell-features = attention, border, title

# macOS
# Left Option sends Alt/Meta (word jumps, readline, nvim); right Option still types special characters
macos-option-as-alt = left
auto-update = check

# Mouse + clipboard
mouse-hide-while-typing = true
copy-on-select = clipboard

# Splits
unfocused-split-opacity = 0.85

# Hotkey window (like iTerm2's): Ctrl+` toggles a drop-down terminal from any app
# (global keybinds need Accessibility permission for Ghostty in System Settings)
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
